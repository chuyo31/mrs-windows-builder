<Window x:Class="MRS.WindowsBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MRS.WindowsBuilder"
        mc:Ignorable="d"
        Title="MRS Windows Builder"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#FF12141A">

    <Window.Resources>

        <!-- ============ Paleta ============ -->
        <SolidColorBrush x:Key="AppBackground" Color="#FF12141A"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FF1C1F27"/>
        <SolidColorBrush x:Key="CardBorder" Color="#FF2A2E39"/>
        <SolidColorBrush x:Key="TopBarBackground" Color="#FF171A21"/>
        <SolidColorBrush x:Key="Accent" Color="#FF2E8BFF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF4C9DFF"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#FF1E6FD8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F4F8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA3B2"/>
        <SolidColorBrush x:Key="FieldBackground" Color="#FF12141A"/>
        <SolidColorBrush x:Key="Disabled" Color="#FF3A3F4B"/>
        <!-- Superficie y texto para botones deshabilitados: sigue leyéndose como disabled
             pero con contraste suficiente (no gris casi invisible). -->
        <SolidColorBrush x:Key="DisabledSurface" Color="#FF454B5A"/>
        <SolidColorBrush x:Key="DisabledBorder" Color="#FF525A6B"/>
        <SolidColorBrush x:Key="DisabledText" Color="#FFC6CDD9"/>

        <!-- ============ Sombra suave para tarjetas ============ -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="0"
                          Opacity="0.45" Color="#FF000000"/>

        <!-- ============ Tarjeta ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- ============ Títulos ============ -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- ============ Botón principal (accent) ============ -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DisabledSurface}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisabledText}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Botón secundario (contorno) ============ -->
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF232733"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1A1D26"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledText}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
                                <Setter TargetName="bd" Property="Background" Value="#FF1B1E27"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Caja de ruta (solo lectura) ============ -->
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ComboBox de edición (tema oscuro completo) ============ -->
        <!-- Se plantilla el ComboBox Y el ComboBoxItem para que el desplegable
             de WPF no vuelva a pintarse con fondo/texto blancos. -->
        <Style x:Key="EditionComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="#FF2A2F3B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="#FF2A2F3B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="itemBd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditionCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource EditionComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="mainBd" Background="{StaticResource FieldBackground}"
                                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="mainBd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="mainBd" Property="Background" Value="{StaticResource DisabledSurface}"/>
                                                <Setter TargetName="mainBd" Property="BorderBrush" Value="{StaticResource DisabledBorder}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <TextBlock x:Name="Placeholder" Text="Selecciona una edición"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" Visibility="Collapsed"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#FF000000"/>
                                    </Border.Effect>
                                    <ScrollViewer Padding="2">
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SelectionBoxItem" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Botón de perfil (RadioButton estilizado) ============ -->
        <Style x:Key="ProfileButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="18,18">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"/>
                                <TextBlock x:Name="tag" Text="Seleccionado"
                                           Foreground="{StaticResource Accent}" FontSize="11"
                                           FontWeight="Normal" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="Background" Value="#332E8BFF"/>
                                <Setter TargetName="tag" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. Barra superior ================= -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="24,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Accent}" CornerRadius="8"
                            Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="MRS" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows Builder" Foreground="{StaticResource TextPrimary}"
                                   FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Constructor de imágenes Windows 11"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#FF3FD07A" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Listo" Margin="8,0,0,0"
                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2/3/4. Paneles ================= -->
        <Grid Grid.Row="1" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: Origen -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Origen" Style="{StaticResource CardTitle}"/>

                    <Button x:Name="SelectIsoButton" Content="Seleccionar ISO"
                            Style="{StaticResource AccentButton}" Click="SelectIsoButton_Click"/>

                    <TextBlock Text="Ruta de la imagen" Style="{StaticResource FieldLabel}"
                               Margin="0,16,0,6"/>
                    <TextBox x:Name="IsoPathBox" Style="{StaticResource PathBox}"
                             Text="" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                    <Button x:Name="AnalyzeButton" Content="Analizar imagen"
                            Style="{StaticResource OutlineButton}" Margin="0,16,0,0"
                            IsEnabled="False" Click="AnalyzeButton_Click"/>

                    <TextBlock Text="Edición" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
                    <ComboBox x:Name="EditionCombo" Style="{StaticResource EditionCombo}"
                              IsEnabled="False"
                              SelectionChanged="EditionCombo_SelectionChanged"/>
                </StackPanel>
            </Border>

            <!-- Panel central: Informacion de la imagen -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="Información de la imagen" Style="{StaticResource CardTitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sistema operativo" Style="{StaticResource FieldLabel}" Margin="0,10"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoOs" Text="--" Style="{StaticResource FieldValue}" Margin="0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Versión" Style="{StaticResource FieldLabel}" Margin="0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoVersion" Text="--" Style="{StaticResource FieldValue}" Margin="0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Build" Style="{StaticResource FieldLabel}" Margin="0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoBuild" Text="--" Style="{StaticResource FieldValue}" Margin="0,10"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Arquitectura" Style="{StaticResource FieldLabel}" Margin="0,10"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoArch" Text="--" Style="{StaticResource FieldValue}" Margin="0,10"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Idioma" Style="{StaticResource FieldLabel}" Margin="0,10"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InfoLang" Text="--" Style="{StaticResource FieldValue}" Margin="0,10"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tipo de imagen (WIM/ESD)" Style="{StaticResource FieldLabel}" Margin="0,10"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="InfoType" Text="--" Style="{StaticResource FieldValue}" Margin="0,10"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Panel derecho: Perfiles -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Perfiles" Style="{StaticResource CardTitle}"/>

                    <RadioButton x:Name="ProfileNormal" Content="NORMAL" GroupName="Profiles"
                                 Style="{StaticResource ProfileButton}" Checked="Profile_Checked"/>
                    <RadioButton x:Name="ProfileLight" Content="LIGHT" GroupName="Profiles"
                                 Style="{StaticResource ProfileButton}" Checked="Profile_Checked"/>
                    <RadioButton x:Name="ProfileMedium" Content="MEDIUM" GroupName="Profiles"
                                 Style="{StaticResource ProfileButton}" Checked="Profile_Checked"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 5. Consola / log ================= -->
        <Border Grid.Row="2" Margin="24,0,24,12" CornerRadius="12" Background="#FF000000"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Registro" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" FontWeight="SemiBold" Margin="16,10,16,6"/>
                <ScrollViewer Grid.Row="1" x:Name="LogScroller" VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,8">
                    <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0"
                             Foreground="#FFB6F5C8" FontFamily="Consolas, Segoe UI"
                             FontSize="12.5" IsReadOnly="True" TextWrapping="Wrap"
                             Padding="16,0,16,8"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= Barra inferior ================= -->
        <Border Grid.Row="3" Background="{StaticResource TopBarBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="24,14">
                <TextBlock x:Name="FooterHint" Text="Selecciona una ISO para comenzar"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center"/>
                <Button x:Name="ContinueButton" Content="Continuar" HorizontalAlignment="Right"
                        Style="{StaticResource AccentButton}" IsEnabled="False"
                        Padding="28,10" Click="ContinueButton_Click"/>
            </Grid>
        </Border>

        <!-- ================= Pantalla de inventario (fase 3) ================= -->
        <Grid x:Name="InventoryOverlay" Grid.Row="0" Grid.RowSpan="4"
              Background="{StaticResource AppBackground}" Visibility="Collapsed" Panel.ZIndex="30">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabecera -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="INVENTARIO DE LA IMAGEN" Foreground="{StaticResource TextPrimary}"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#FF3FD07A" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InventoryStatus" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="#FF8FE3AE" FontSize="12" FontWeight="SemiBold"
                                   Text="Imagen inventariada correctamente"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="0" x:Name="InventorySubtitle" HorizontalAlignment="Right"
                           VerticalAlignment="Top" Foreground="{StaticResource TextSecondary}" FontSize="12" Text="--"/>

                <!-- Contadores -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Paquetes" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="CountPackages" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Apps" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="CountApps" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Features" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="CountFeatures" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Capabilities" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="CountCapabilities" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Drivers" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="CountDrivers" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Categorías + lista -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="8">
                        <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource TextPrimary}" FontSize="13"
                                 SelectionChanged="CategoryList_SelectionChanged">
                            <ListBoxItem Content="Paquetes"/>
                            <ListBoxItem Content="Apps"/>
                            <ListBoxItem Content="Features"/>
                            <ListBoxItem Content="Capabilities"/>
                            <ListBoxItem Content="Drivers"/>
                        </ListBox>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="4">
                        <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent"
                                  BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="Detalles" Binding="{Binding Details}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Acciones -->
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Button x:Name="InventoryBackButton" Content="Volver" HorizontalAlignment="Left"
                            Style="{StaticResource OutlineButton}" Padding="24,10" Click="InventoryBackButton_Click"/>
                    <Button x:Name="InventoryNextButton" Content="Continuar" HorizontalAlignment="Right"
                            Style="{StaticResource AccentButton}" Padding="28,10" Click="InventoryNextButton_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
